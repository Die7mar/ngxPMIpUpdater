# ============================================================
#  ngxPMIpUpdater – Konfiguration
#  Kopiere diese Datei zu ".env" und trage deine Werte ein.
#  Die .env Datei NIEMALS in Git committen!
# ============================================================

# Wie oft die IPs aktualisiert werden (in Minuten)
INTERVAL_MINUTES=60

# ------------------------------------------------------------
# Domains (DynDNS / Hostnamen) – werden stündlich aufgelöst.
# Beliebig viele, mit Komma getrennt. Leer lassen, wenn keine gebraucht werden.
# ------------------------------------------------------------
DOMAINS=mein-haus.dyndns.org,buero.example.com

# ------------------------------------------------------------
# Statische IP-Blöcke – werden immer erlaubt (z. B. internes Netz)
# Format: x.x.x.x/CIDR  (einzelne IP = /32)
# Beliebig viele, mit Komma getrennt.
# ------------------------------------------------------------
STATIC_IPS=192.168.1.0/24,10.0.0.5/32

# Ungültige Einträge werden verworfen und geloggt, nicht stillschweigend übernommen.
# "0.0.0.0/0" wird abgelehnt, weil es den Proxy für das gesamte Internet öffnet –
# nur auf true setzen, wenn das wirklich gewollt ist.
ALLOW_OPEN_BLOCKS=false

# ------------------------------------------------------------
# IPv6: AAAA-Records ebenfalls als /128 eintragen.
# Standard aus – bei vielen Heimanschlüssen wechselt die IPv6-Adresse durch
# Privacy Extensions, eine /128-Regel wäre dann schnell veraltet.
# ------------------------------------------------------------
RESOLVE_IPV6=false

# ------------------------------------------------------------
# Aussperr-Schutz: Löst eine Domain nicht auf, wird ihre letzte gute IP
# höchstens so viele Stunden weiterverwendet. Danach wird sie entfernt –
# eine alte DynDNS-IP kann längst einem fremden Anschluss gehören.
# 0 = unbegrenzt (nicht empfohlen).
# ------------------------------------------------------------
FALLBACK_MAX_AGE_HOURS=72

# ------------------------------------------------------------
# Nginx Proxy Manager
# ------------------------------------------------------------
NPM_BASE_URL=http://nginx-proxy-manager:81

# Empfohlen (NPM >= v2.13): Langlebiger API-Token
# Erstellen: NPM UI → Access → API Tokens → Add Token
# Wenn gesetzt, werden NPM_EMAIL und NPM_PASSWORD ignoriert.
#
# Noch besser: den Token als Docker-Secret hinterlegen statt als Umgebungsvariable.
# Env-Variablen sind über "docker inspect" und /proc/<pid>/environ lesbar.
# Dazu den secrets-Block in docker-compose.yml einkommentieren.
NPM_API_TOKEN=

# Fallback für ältere NPM-Versionen (< v2.13)
NPM_EMAIL=admin@example.com
NPM_PASSWORD=changeme

# ID der Access List, die aktualisiert werden soll
# Zu finden in der NPM URL: /access-lists/1/edit → ID = 1
NPM_ACCESS_LIST_ID=1

# ------------------------------------------------------------
# Cloudflare Tunnel (optional) – leer lassen, wenn nicht genutzt
# Pflegt die IP-Regeln einer Zero Trust Access Group; die Gruppe in einer
# Bypass-Policy der Application verwenden (Details im README).
# Wird nur Cloudflare genutzt, NPM_BASE_URL leer lassen.
#
# CF_ACCOUNT_ID:      32 Zeichen, aus der URL dash.cloudflare.com/<account-id>/
# CF_ACCESS_GROUP_ID: UUID der Access Group
# CF_API_TOKEN:       Custom Token mit
#                     Account → Access: Organizations, Identity Providers, and Groups → Edit
#                     (besser als Secret-File, siehe docker-compose.yml)
# ------------------------------------------------------------
CF_ACCOUNT_ID=
CF_ACCESS_GROUP_ID=
CF_API_TOKEN=

# ------------------------------------------------------------
# Benachrichtigungen (optional) – NOTIFY_URL leer lassen zum Deaktivieren
#   ntfy:   NOTIFY_URL=https://ntfy.sh/mein-geheimes-topic
#   Gotify: NOTIFY_URL=https://gotify.example.com/message  NOTIFY_TYPE=gotify
#   Discord: NOTIFY_URL=https://discord.com/api/webhooks/<id>/<token>  NOTIFY_TYPE=discord
#            (die URL ist das Geheimnis – besser als Secret-File, siehe docker-compose.yml)
#   JSON:   beliebiger Endpunkt, der einen JSON-POST annimmt  NOTIFY_TYPE=json
# NOTIFY_TOKEN: ntfy-Access-Token bzw. Gotify-App-Token (optional bei ntfy, unnötig bei Discord)
# NOTIFY_ON_CHANGE=false meldet nur noch Sperre, Fehler und Erholung,
# nicht jede neue DynDNS-IP.
# ------------------------------------------------------------
NOTIFY_URL=
NOTIFY_TYPE=ntfy
NOTIFY_TOKEN=
NOTIFY_ON_CHANGE=true

# ------------------------------------------------------------
# Docker-Netzwerk
# Name des Docker-Netzwerks, in dem NPM läuft.
# Prüfen mit: docker network ls
# Ohne NPM (nur Cloudflare) den networks-Block in docker-compose.yml entfernen.
# ------------------------------------------------------------
NPM_NETWORK_NAME=nginx-proxy-manager_default
